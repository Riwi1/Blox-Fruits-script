        root.CFrame = CFrame.new(-1428, 70, -35)
    end
end)

-- ============================================================
--  LOOP PRINCIPAL (Farm)
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not farmRunning then return end
    
    local char = getChar()
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local enemy = getNearestEnemy(devFarm and 500 or 150)
    
    if enemy then
        local root = getRoot()
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
        
        if root and enemyRoot then
            local dist = (enemyRoot.Position - root.Position).Magnitude
            
            -- Se estiver longe, move até o inimigo. Se tiver perto, ataca.
            if dist > 15 then
                humanoid:MoveTo(enemyRoot.Position)
            else
                humanoid:MoveTo(root.Position) -- Para de andar
                attack()
            end
        end
    end
end)

