local function findNearestEnemy(range)
    range = range or 100
    local char = getCharacter()
    local root = char:FindFirstChild("HumanoidRootPoint") or char:FindFirstChild("HumanoidRoot")
    if not root then return nil end

    local best, bestDist = nil, range
    for _, target in ipairs(workspace:GetChildren()) do
        if target ~= char and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 then
            local tRoot = target:FindFirstChild("HumanoidRootPoint") or target:FindFirstChild("HumanoidRoot")
            if tRoot then
                local dist = (tRoot.Position - root.Position).Magnitude
                if dist < bestDist then
                    best, bestDist = target, dist
                end
            end
        end
    end
    return best
