local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "BloxHub"
    gui.ResetOnSpawn = false
    -- Fallback para CoreGui se o executor suportar
    if gethui then gui.Parent = gethui() else gui.Parent = playerGui end

    -- Botão Flutuante pra abrir/fechar
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 45, 0, 45)
    toggleBtn.Position = UDim2.new(0, 20, 0, 100)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 240)
    toggleBtn.Text = "≡"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 24
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Parent = gui
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = toggleBtn

    -- Menu Principal
    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, 260, 0, 400)
    main.Position = UDim2.new(0.5, -130, 0.5, -200)
    main.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    main.BorderSizePixel = 0
    main.Active = true
    main.Parent = gui
    main.Visible = false -- Começa fechado
    
    local mc = Instance.new("UICorner")
    mc.CornerRadius = UDim.new(0, 10)
    mc.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 35)
    title.BackgroundColor3 = Color3.fromRGB(40, 120, 240)
    title.Text = " Blox Fruits Hub"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 16
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main
    
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(0, 10)
    tc.Parent = title

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -10, 1, -45)
    scroll.Position = UDim2.new(0, 5, 0, 40)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 2
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = main

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroll

    -- Lógica de Abrir/Fechar
    toggleBtn.MouseButton1Click:Connect(function()
        main.Visible = not main.Visible
        toggleBtn.Text = main.Visible and "X" or "≡"
        toggleBtn.BackgroundColor3 = main.Visible and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(40, 120, 240)
    end)

    -- Funções Auxiliares da UI
    local function makeBtn(text, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 40)
        btn.BackgroundColor3 = color or Color3.fromRGB(50, 50, 58)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Text = text
        btn.Parent = scroll
        
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = btn
        return btn
    end

    return makeBtn, title
end

local makeBtn, titleBar = createUI()

-- ============================================================
--  LÓGICA DO JOGO
-- ============================================================
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRoot()
    local char = getChar()
    return char:FindFirstChild("HumanoidRootPart")
end

-- Acha o inimigo mais próximo (funciona para mobs no Blox Fruits)
local function getNearestEnemy(range)
    local root = getRoot()
    if not root then return nil end
    
    local nearest = nil
    local dist = range or 150
    
    for _, v in pairs(workspace:GetChildren()) do
        if v ~= LocalPlayer.Character and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v.Humanoid.Health > 0 then
                local mag = (v.HumanoidRootPart.Position - root.Position).Magnitude
                if mag < dist then
                    nearest = v
                    dist = mag
                end
            end
        end
    end
    return nearest
end

-- Tenta equipar a arma e atacar
local function attack()
    local char = getChar()
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    else
        -- Se não tiver arma equipada, tenta dar um soco (combate corpo a corpo)
        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(0.1)
        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end
end

