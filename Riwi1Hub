local function attackTarget(target)
    local char = getCharacter()
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    -- Simula ataque automático contra o alvo mais próximo
    pcall(function()
        -- Tenta usar a skill de combate padrão do jogo
        local cmd = ReplicatedStorage:FindFirstChild("DefaultRemotes")
        if cmd then
            pcall(function() cmd:Fire("attack", target) end)
        end
    end)
end

local function teleportTo(location)
    -- Teleport básico para ilhas usando CFrame do HumanoidRootPoint
    local char = getCharacter()
    local root = char:FindFirstChild("HumanoidRootPoint") or char:FindFirstChild("HumanoidRoot")
    if not root then return end

    local destinations = {
        second = Vector3.new(-1428, 70, -35),
    }
    local pos = destinations[location]
    if pos then
        pcall(function() root.CFrame = CFrame.new(pos) end)
    end
end

