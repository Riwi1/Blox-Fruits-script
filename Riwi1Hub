local function round(r) return math.abs(r) end

local function createGui(name, title)
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.Archivable = false
    gui.IgnoreGuiOrder = true
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UINumber.new(12)
    corner.Parent = gui

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, 0, 0, 45)
    titleLbl.BackgroundTransparency = 0.1
    titleLbl.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    titleLbl.Text = title
    titleLbl.TextColor = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 18
    titleLbl.BorderSizePixel = 0
    titleLbl.Parent = gui

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UINumber.new(12)
    tc.Parent = titleLbl

    return gui, titleLbl
end

local function makeButton(parent, size, position, text, color)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = position
    btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 75)
    btn.TextColor = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.BorderSizePixel = 0
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UINumber.new(8)
    c.Parent = btn
    return btn
end

